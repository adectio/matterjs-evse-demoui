# Data Fetcher Configuration

# Kraken API (EDF FreePhase)
# Get your API key from: https://kraken.energy
KRAKEN_API_KEY=your_kraken_api_key_here

# Octopus Agile API
# Get your API key from: https://octopus.energy
OCTOPUS_API_KEY=your_octopus_api_key_here
OCTOPUS_PRODUCT_CODE=AGILE-22-11-01
OCTOPUS_REGION=A

# UK Carbon Intensity Data
# Data from: https://carbonintensity.org
# Optional: specify a UK postcode for regional data, leave blank for national
UK_POSTCODE=

# Redis Configuration
# Only required if you want to use Redis caching instead of SQLite-only
REDIS_HOST=localhost
REDIS_PORT=6379

# Server Configuration
PORT=3000
API_PORT=8080
